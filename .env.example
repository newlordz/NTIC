# NTIC Platform - environment template
#
# Copy to `.env` in the repository root and fill in real values:
#     cp .env.example .env
#
# `.env` is git-ignored. Never commit real secrets.
# On Railway, set these in the service's Variables tab instead of using a file.

# ─────────────────────────────────────────────────────────────────────
# Database (required)
# ─────────────────────────────────────────────────────────────────────
# Option A - a single connection URL. Takes priority over the PG* vars below,
# and is what Railway provides automatically.
# DATABASE_URL=postgresql://user:password@host:5432/NticPlatformDb
# DATABASE_PRIVATE_URL=

# Option B - discrete variables, typical for local development.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=NticPlatformDb

# ─────────────────────────────────────────────────────────────────────
# Bootstrap administrator (required on first run)
# ─────────────────────────────────────────────────────────────────────
# Used ONLY when the admin account does not yet exist. If unset, the server
# generates a strong random password and prints it once in the startup log.
#
# An existing admin's password is never overwritten on restart. To rotate it
# deliberately: set NTIC_ADMIN_PASSWORD to the new value, set
# NTIC_ADMIN_PASSWORD_RESET=true, restart once, then REMOVE the reset flag.
NTIC_ADMIN_PASSWORD=
# NTIC_ADMIN_PASSWORD_RESET=false

# ─────────────────────────────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────────────────────────────
PORT=5000

# Auto-reload on file changes. DEVELOPMENT ONLY - it runs a second
# file-watching process and prevents clean shutdown. run_backend.bat sets this
# for you; production entry points must leave it unset.
# NTIC_DEV_RELOAD=true

# Interactive API docs at /docs, /redoc and /openapi.json. These publish the
# full schema of every endpoint, so they default to ON only when
# NTIC_DEV_RELOAD is set. Set explicitly to override.
# NTIC_ENABLE_DOCS=false

# Set to true to disable cross-replica WebSocket fan-out (PostgreSQL
# LISTEN/NOTIFY). Only useful for debugging.
# NTIC_DISABLE_WS_FANOUT=false

# ─────────────────────────────────────────────────────────────────────
# Email - Brevo (optional; without it, no email is sent)
# ─────────────────────────────────────────────────────────────────────
BREVO_API_KEY=
# MUST be a verified sender in your Brevo account, or every send is rejected.
# The server always uses this address; clients cannot choose the From address.
MAIL_FROM_EMAIL=no-reply@ntic.org.gh
MAIL_FROM_NAME=NTIC Ghana Championship
# Where security alerts go. Defaults to MAIL_FROM_EMAIL.
SECURITY_ALERT_EMAIL=

# ─────────────────────────────────────────────────────────────────────
# AI assistant - Google Gemini (optional; without it the chatbot is disabled)
# ─────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=

# ─────────────────────────────────────────────────────────────────────
# SMS / WhatsApp OTP delivery (optional)
# ─────────────────────────────────────────────────────────────────────
# Points at the whatsapp-gateway service. The BACKEND calls this, not the
# browser. Without it, phone verification reports itself as unavailable rather
# than silently failing.
# Local development: http://localhost:3001
SMS_GATEWAY_URL=

# ─────────────────────────────────────────────────────────────────────
# Privacy / compliance
# ─────────────────────────────────────────────────────────────────────
# Masks the last octet of client IPs before they are written to audit_logs.
# Recommended: true.
ENABLE_IP_ANONYMIZATION=true

# ─────────────────────────────────────────────────────────────────────
# Audit log cold storage (optional but recommended)
# ─────────────────────────────────────────────────────────────────────
# The retention job gzips old audit records, verifies the archive, uploads it,
# and only THEN deletes the database rows.
#
# Without a bucket the archive would land on the container filesystem, which is
# discarded on the next deploy. The job therefore REFUSES to delete anything and
# logs why. Set a bucket, or set AUDIT_ALLOW_EPHEMERAL_ARCHIVE=true if
# AUDIT_ARCHIVE_DIR points at a persistent volume.
S3_AUDIT_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
# For Cloudflare R2 or another S3-compatible endpoint.
AWS_S3_ENDPOINT_URL=
# Where archives are staged before upload.
# AUDIT_ARCHIVE_DIR=/var/lib/ntic/audit_archives
# AUDIT_ALLOW_EPHEMERAL_ARCHIVE=false

# ─────────────────────────────────────────────────────────────────────
# Database backups (scripts/db_backup.py)
# ─────────────────────────────────────────────────────────────────────
# Bucket for `db_backup.py backup --upload`. Falls back to S3_AUDIT_BUCKET.
# Dumps contain password hashes and session tokens - keep the bucket private.
BACKUP_S3_BUCKET=

# ─────────────────────────────────────────────────────────────────────
# Frontend production server (only when running NticPlatform.Frontend/server.js)
# ─────────────────────────────────────────────────────────────────────
# Where server.js proxies /api to. Irrelevant when the Python backend serves
# the built frontend itself (the root Dockerfile setup).
BACKEND_URL=http://127.0.0.1:5000
